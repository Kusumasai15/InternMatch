{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/app/**,data/internships.json}",
      "excludeFiles": "{.venv/**,backend/.venv/**,backend/data/**,backend/tests/**,.local-logs/**,node_modules/**,src/**,dist/**,docs/**}",
      "maxDuration": 60
    }
  }
}
